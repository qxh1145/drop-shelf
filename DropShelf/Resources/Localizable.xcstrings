    "History": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử"
          }
        }
      }
    },
    "Hold and drag the sample file left and right a few times. This uses the same motion you will make while dragging a real file in Finder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ và kéo tệp mẫu qua trái, qua phải vài lần. Đây chính là thao tác bạn sẽ làm khi kéo tệp thật trong Finder."
          }
        }
      }
    },
    "Image Tools": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ ảnh"
          }
        }
      }
    },
    "Image Tools (%lld Items)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ ảnh (%lld mục)"
          }
        }
      }
    },
    "JPEG uses lossy compression and does not support transparency. Transparent pixels will be placed on a white background. Animated WEBP files are not converted.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG nén có suy giảm chất lượng và không hỗ trợ độ trong suốt. Vùng trong suốt sẽ được đặt trên nền trắng. Không chuyển được tệp WEBP động."
          }
        }
      }
    },
    "JPEG does not support transparency. Transparent pixels will be placed on a white background.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG không hỗ trợ độ trong suốt. Vùng trong suốt sẽ được đặt trên nền trắng."
          }
        }
      }
    },
    "JPEG uses lossy compression. HDR range and some HEIC metadata may be reduced. For a multi-image HEIF/HEICS file, only its primary image is converted.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG nén mất dữ liệu. Dải HDR và một số metadata HEIC có thể bị giảm. Với tệp HEIF/HEICS nhiều ảnh, chỉ ảnh chính được chuyển."
          }
        }
      }
    },
    "Keep DropShelf available from the menu bar after signing in.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ DropShelf trên thanh menu sau khi đăng nhập."
          }
        }
      }
    },
    "Keep items after dragging out": {
      "localizations": {
