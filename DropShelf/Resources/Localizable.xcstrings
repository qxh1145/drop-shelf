          }
        }
      }
    },
    "DropShelf Shelf": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kệ DropShelf"
          }
        }
      }
    },
    "DropShelf couldn’t read the selection.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DropShelf không đọc được nội dung đã chọn."
          }
        }
      }
    },
    "DropShelf creates a temporary floating shelf while you drag files in Finder. It keeps references only—your files stay exactly where they are.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DropShelf tạo một kệ nổi tạm thời khi bạn kéo tệp trong Finder. Ứng dụng chỉ giữ tham chiếu, tệp của bạn vẫn nằm nguyên chỗ cũ."
          }
        }
      }
    },
    "DropShelf does not have permission to read the source file.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DropShelf không có quyền đọc tệp nguồn."
          }
        }
      }
    },
    "DropShelf stays available from the menu bar and uses almost no CPU while idle.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DropShelf luôn sẵn trên thanh menu và gần như không dùng CPU khi rảnh."
          }
        }
      }
    },
    "Earlier": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước đó"
          }
        }
      }
    },
    "Enabled": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang bật"
          }
        }
      }
    },
    "Enter a name.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhập tên."
          }
        }
      }
    },
    "Every PDF page will be rasterized as a lossy JPEG at 144 DPI. Text, vectors, links, forms, and annotations will no longer be editable. A multi-page PDF creates one JPEG per page.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi trang PDF sẽ thành ảnh JPEG nén mất dữ liệu ở 144 DPI. Văn bản, hình vector, liên kết, biểu mẫu và chú thích sẽ không còn chỉnh sửa được. PDF nhiều trang tạo ra mỗi trang một tệp JPEG."
          }
        }
      }
    },
    "Every PDF page will be rasterized at 144 DPI. Text, vectors, links, forms, and annotations will no longer be editable. A multi-page PDF creates one PNG per page.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi trang PDF sẽ thành ảnh ở 144 DPI. Văn bản, hình vector, liên kết, biểu mẫu và chú thích sẽ không còn chỉnh sửa được. PDF nhiều trang tạo ra mỗi trang một tệp PNG."
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp"
          }
        }
      }
    },
    "Files are renamed in place, numbered in Shelf order: “Name 1”, “Name 2”, … Extensions are kept.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp được đổi tên tại chỗ, đánh số theo thứ tự trên Kệ: “Tên 1”, “Tên 2”, … Phần mở rộng được giữ nguyên."
          }
        }
      }
    },
    "Filter items": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọc mục"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chung"
          }
        }
